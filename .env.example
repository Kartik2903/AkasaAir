# Copy to .env (never commit .env)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/leaveflow?schema=public
# Exact frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# lax when frontend and API share a site (dev proxy, one domain). none (forces Secure) for different sites.
COOKIE_SAMESITE=lax
# Where uploaded documents are stored (local disk). Use object storage when deployed: see docs/deployment.md
# Cloudflare R2 (S3 API). Set all three to store documents in R2; leave unset for local disk.
# STORAGE_BUCKET_API=https://<account-id>.r2.cloudflarestorage.com/<bucket>
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
UPLOAD_DIR=uploads
# Frontend build only: API origin. Leave empty to call /api on the same origin (dev proxy / reverse proxy)
VITE_API_URL=
